#!/bin/bash
# Show or hide the sticky note. Toggle the existing GTK single instance when
# running; otherwise start a visible instance.
set -euo pipefail

BIN="$(dirname "$(readlink -f "$0")")/omarchy-stickynote"
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-stickynote.pid"

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
  "$BIN" --toggle
else
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- "$BIN" >/dev/null 2>&1 &
  else
    "$BIN" >/dev/null 2>&1 &
  fi
  disown
fi
